{
  "name": "rescue-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build && npm run build:_headers",
    "build:_headers": "node scripts/dist/gen_headers.js ./public/docs ./dist/_headers",
    "lint": "eslint src scripts/src",
    "lint:fix": "eslint src scripts/src --fix",
    "pretty": "npx prettier '**/*.{tsx,ts,js,html}' --write",
    "pretty:check": "npx prettier '**/*.{tsx,ts,js,html}' --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^9.6.0",
    "@mui/material": "^9.6.0",
    "@reown/appkit": "^2.0.0",
    "@reown/appkit-adapter-wagmi": "^2.0.0",
    "@reown/appkit-controllers": "^2.0.0",
    "@tanstack/query-core": "^5.108.4",
    "@tanstack/react-query": "^5.108.4",
    "@wagmi/connectors": "^8.2.4",
    "@wagmi/core": "^3.6.9",
    "buffer": "^6.0.3",
    "moment": "^2.31.0",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "util": "^0.12.4",
    "viem": "^2.58.4",
    "wagmi": "^3.7.11"
