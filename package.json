    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-love": "^155.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "glob": "^13.0.7",
    "globals": "^17.14.0",
    "node-html-parser": "^6.1.11",
    "prettier": "3.10.1",
    "sha256": "^0.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-checker": "^1.0.0"
  }
